{
  "name": "@xfeatures/athenaeum-types",
  "version": "0.2.0",
  "description": "TypeScript types for Xfeatures Athenaeum's REST API. Hand-authored from the Worker's own DTOs and schemas, not generated -- kept in sync manually until the surface stabilizes.",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "keywords": [
    "athenaeum",
    "xfeatures",
    "typescript",
    "types",
    "knowledge-base",
    "rag",
    "cloudflare-workers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XfeaturesGroup/XfeaturesAthenaeumSDK.git",
    "directory": "packages/athenaeum-types"
  },
  "homepage": "https://github.com/XfeaturesGroup/XfeaturesAthenaeumSDK/tree/main/packages/athenaeum-types#readme",
  "bugs": {
    "url": "https://github.com/XfeaturesGroup/XfeaturesAthenaeumSDK/issues"
  }
}
