{
  "name": "@xfeaturesgroup/athenaeum-cli",
  "version": "0.2.0",
  "description": "Command-line client for Xfeatures Athenaeum: sign in with your Xfeatures Account over OAuth 2.0 PKCE, then search and read from the terminal.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "athenaeum": "dist/cli.js"
  },
  "files": [
    "LICENSE",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@xfeaturesgroup/athenaeum": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "xfeatures",
    "athenaeum",
    "cli",
    "oauth2",
    "pkce",
    "knowledge-base",
    "retrieval",
    "ai-agents",
    "command-line",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XfeaturesGroup/XfeaturesAthenaeumCLI.git"
  },
  "homepage": "https://github.com/XfeaturesGroup/XfeaturesAthenaeumCLI#readme",
  "bugs": {
    "url": "https://github.com/XfeaturesGroup/XfeaturesAthenaeumCLI/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
